# Data source for services: "mock" (in-browser demo data) or "api" (real backend)
VITE_DATA_SOURCE=mock
# Base URL of the FactoryOps API (used when VITE_DATA_SOURCE=api)
VITE_API_URL=https://localhost:7001/api
# Enables the development-only demo login / role switcher. Never enable in production.
VITE_DEMO_AUTH=true
